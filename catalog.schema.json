{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://indieverse.app/schemas/catalog.v1.json",
  "title": "IndieVerse Catalog",
  "description": "Contrato del catálogo público de IndieVerse. Versión 1.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "checksum", "genres", "creators", "works"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Versión del schema. Cambios incompatibles incrementan este número."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO-8601 UTC de generación del catálogo."
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 del payload sin el campo checksum. Formato: sha256:<hex>."
    },
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/genre" }
    },
    "creators": {
      "type": "array",
      "items": { "$ref": "#/definitions/creator" }
    },
    "works": {
      "type": "array",
      "items": { "$ref": "#/definitions/work" }
    }
  },

  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80,
      "description": "Identificador legible: minúsculas, números y guiones."
    },
    "urlHttps": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "URLs de media deben ser HTTPS."
    },
    "rating": {
      "type": "object",
      "required": ["average", "count"],
      "additionalProperties": false,
      "properties": {
        "average": { "type": "number", "minimum": 0, "maximum": 10 },
        "count":   { "type": "integer", "minimum": 0 }
      }
    },
    "genre": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":   { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "creator": {
      "type": "object",
      "required": ["id", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "id":        { "$ref": "#/definitions/slug" },
        "name":      { "type": "string", "minLength": 1, "maxLength": 80 },
        "role":      { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarUrl": { "$ref": "#/definitions/urlHttps" },
        "bio":       { "type": "string", "maxLength": 400 }
      }
    },
    "subtitle": {
      "type": "object",
      "required": ["lang", "url"],
      "additionalProperties": false,
      "properties": {
        "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "url":  { "$ref": "#/definitions/urlHttps" }
      }
    },
    "video": {
      "type": "object",
      "required": ["id", "label", "durationSec", "mediaId"],
      "additionalProperties": false,
      "properties": {
        "id":          { "$ref": "#/definitions/slug" },
        "label":       { "type": "string", "minLength": 1, "maxLength": 60 },
        "durationSec": { "type": "integer", "minimum": 1 },
        "mediaId":     { "type": "string", "minLength": 1, "maxLength": 120 },
        "hlsUrl":      { "oneOf": [{ "$ref": "#/definitions/urlHttps" }, { "type": "null" }] },
        "mp4Url":      { "oneOf": [{ "$ref": "#/definitions/urlHttps" }, { "type": "null" }] },
        "subtitles": {
          "type": "array",
          "items": { "$ref": "#/definitions/subtitle" }
        }
      },
      "anyOf": [
        { "required": ["hlsUrl"], "properties": { "hlsUrl": { "type": "string" } } },
        { "required": ["mp4Url"], "properties": { "mp4Url": { "type": "string" } } }
      ],
      "description": "Un video debe tener al menos hlsUrl o mp4Url no nulo."
    },
    "chapter": {
      "type": "object",
      "required": ["id", "number", "title", "pageCount", "status", "pages"],
      "additionalProperties": false,
      "properties": {
        "id":        { "$ref": "#/definitions/slug" },
        "number":    { "type": "integer", "minimum": 0 },
        "title":     { "type": "string", "minLength": 1, "maxLength": 120 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "status":    { "type": "string", "enum": ["new", "ongoing", "completed"] },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/urlHttps" }
        }
      },
      "description": "pageCount debe coincidir con pages.length — validado en CI, no por JSON Schema."
    },
    "work": {
      "type": "object",
      "required": ["id", "type", "title", "synopsis", "year", "genres", "rating", "coverUrl", "creatorIds", "status", "publishedAt"],
      "additionalProperties": false,
      "properties": {
        "id":          { "$ref": "#/definitions/slug" },
        "type":        { "type": "string", "enum": ["comic", "video"] },
        "subtype":     { "type": "string", "enum": ["short", "feature", "series"] },
        "title":       { "type": "string", "minLength": 1, "maxLength": 120 },
        "synopsis":    { "type": "string", "minLength": 1, "maxLength": 800 },
        "year":        { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "genres": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slug" }
        },
        "rating":      { "$ref": "#/definitions/rating" },
        "coverUrl":    { "$ref": "#/definitions/urlHttps" },
        "backdropUrl": { "$ref": "#/definitions/urlHttps" },
        "creatorIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slug" }
        },
        "status":      { "type": "string", "enum": ["published", "draft", "review"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/definitions/chapter" }
        },
        "videos": {
          "type": "array",
          "items": { "$ref": "#/definitions/video" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "comic" } }, "required": ["type"] },
          "then": {
            "required": ["chapters"],
            "properties": { "chapters": { "minItems": 1 }, "videos": false }
          }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": {
            "required": ["videos"],
            "properties": { "videos": { "minItems": 1 }, "chapters": false }
          }
        }
      ]
    }
  }
}
